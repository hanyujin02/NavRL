<launch>
    <!-- Pre-flight debug preset: real PX4/mavros odom + real depth camera feed
         the policy exactly as in a real flight, but dry_run suppresses arm,
         OFFBOARD, and every setpoint/velocity command — nothing actuates the
         vehicle. Publish goals from rviz's "2D Nav Goal" and watch the
         /rl_navigation/cmd (and /rl_navigation/cbf_cmd, if use_cbf:=true)
         arrows to sanity-check the policy before an actual flight test. -->
    <arg name="height_control" default="false" />
    <arg name="takeoff_height" default="1.0" />
    <arg name="use_cbf"        default="false" />

    <arg name="depth_topic"   default="/camera/depth/image_rect_raw" /> 
    <arg name="odom_topic"    default="/mavros/local_position/odom" />  #/CERLAB/quadcopter/odom
    <arg name="goal_topic"    default="/move_base_simple/goal" />

    <arg name="checkpoint"    default="al1.0_obs350_reachae_step2000_sr0.898_coll0.102.pt" />

    <arg name="rviz"          default="true" />

    <include file="$(find navigation_runner)/launch/navigation.launch">
        <arg name="use_px4"        value="true" />
        <arg name="dry_run"        value="true" />
        <arg name="height_control" value="$(arg height_control)" />
        <arg name="takeoff_height" value="$(arg takeoff_height)" />
        <arg name="use_cbf"        value="$(arg use_cbf)" />
        <arg name="depth_topic"    value="$(arg depth_topic)" />
        <arg name="odom_topic"     value="$(arg odom_topic)" />
        <arg name="goal_topic"     value="$(arg goal_topic)" />
        <arg name="checkpoint"     value="$(arg checkpoint)" />
        <arg name="rviz"           value="$(arg rviz)" />
    </include>
</launch>
